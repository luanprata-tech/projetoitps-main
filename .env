# Configurações do banco PostgreSQL
POSTGRES_USER=projetos
POSTGRES_PASSWORD=projetos
POSTGRES_DB=projetositps

# String de conexão usada pelo SQLAlchemy e Alembic no backend
DATABASE_URL=postgresql+psycopg://projetos:projetos@db:5432/projetositps

# Origens permitidas no CORS da API FastAPI (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Executa o seed inicial automático apenas quando as tabelas estiverem vazias
AUTO_SEED=true

# Autenticação JWT (tempo padrão de expiração: 60 minutos = 1 hora)
JWT_SECRET_KEY=projetositps-chave-dev-altere-em-producao-2026
JWT_EXPIRE_MINUTES=60

# Credenciais do administrador inicial criado automaticamente se não houver usuários
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123

# URL pública da API consumida pelo frontend no navegador
VITE_API_URL=http://localhost:8000

# Armazenamento de anexos e relatórios finais na pasta de rede SMB/CIFS
STORAGE_BASE_DIR=/storage
STORAGE_NETWORK_PATH=\\172.23.6.7\geprocon\ProjetosITPS
SMB_HOST=172.23.6.7
SMB_SHARE_DEVICE=//172.23.6.7/geprocon/ProjetosITPS
SMB_USERNAME=administrator
SMB_PASSWORD=18**G31nf0rm**18
# Se a rede exigir domínio Active Directory, acrescente ",domain=SEU_DOMINIO" ao final de SMB_OPTIONS
SMB_OPTIONS=vers=3.0,file_mode=0777,dir_mode=0777
